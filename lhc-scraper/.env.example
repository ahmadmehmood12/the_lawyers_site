# LHC reported-judgments listing page (the Latest Reported Judgments table).
LHC_LISTING_URL=https://data.lhc.gov.pk/reported_judgments/judgments_approved_for_reporting

# Laravel endpoint. Use the public site origin that serves the Laravel app.
JUDGMENTS_IMPORT_URL=https://example.com/api/judgments/import

# Must match JUDGMENTS_IMPORT_TOKEN in the Laravel .env.
JUDGMENTS_IMPORT_TOKEN=replace-with-the-same-token-as-laravel

# HTTP timeouts (seconds) and retry attempts for temporary failures.
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Optional override.
# USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36
