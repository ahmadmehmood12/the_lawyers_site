{
  "expo": {
    "name": "Wakeel Diary",
    "slug": "wakeel-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wakeeldiary",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.wakeeldiary.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Wakeel Diary securely.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "pk.wakeeldiary.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f2c1e"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-local-authentication",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#0f2c1e",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#08180f"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f2c1e",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": ""
      }
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0f2c1e",
    "primaryColor": "#0f2c1e",
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0f2c1e"
    }
  }
}