# Balochistan High Court (judge list is built in; nothing to set here).
REQUEST_TIMEOUT=120

# AI summaries (optional). Leave ANTHROPIC_API_KEY empty to skip them.
# Default model claude-opus-5-5; claude-haiku-5-5 is much cheaper for the first full import.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5-5
SUMMARY_EFFORT=medium

# Laravel endpoint and token (the same for all four scrapers).
# The text-index endpoint is derived automatically (.../judgments/import -> .../judgments/text).
JUDGMENTS_IMPORT_URL=https://example.com/api/judgments/import
JUDGMENTS_IMPORT_TOKEN=replace-with-the-same-token-as-laravel

# Timeouts and pacing (seconds). REQUEST_DELAY = between court requests; IMPORT_DELAY = between imports.
MAX_RETRIES=3
REQUEST_DELAY=1.0
IMPORT_DELAY=0.15
