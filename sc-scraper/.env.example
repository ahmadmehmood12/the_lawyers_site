# Supreme Court "Latest Judgments" page (no captcha; the newest judgments, about 25).
SC_LATEST_URL=https://scp.gov.pk/LatestJudgments

# Saved on every record as the source page.
SC_SOURCE_URL=https://scp.gov.pk/JudgmentsSearch

# Laravel endpoint and token (the same as the LHC and PHC scrapers).
JUDGMENTS_IMPORT_URL=https://example.com/api/judgments/import
JUDGMENTS_IMPORT_TOKEN=replace-with-the-same-token-as-laravel

REQUEST_TIMEOUT=60
MAX_RETRIES=3
# Seconds between requests to the court website (PDF downloads).
REQUEST_DELAY=1.0

# Identifies the scraper to the court's servers.
# USER_AGENT=Mozilla/5.0 (compatible; DaBarristerJudgments/1.0)
